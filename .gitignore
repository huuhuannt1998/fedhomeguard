# Datasets: ~10 GB of IoT-23 and N-BaIoT captures. Fetched, not versioned --
# scripts/fetch_data.py and scripts/fetch_nbaiot_missing.sh reproduce them.
data/

# The manuscript is kept out of this repository deliberately.
manuscripts/

# Run logs: large, transient, and regenerated by any re-run.
logs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# Local tooling / OS
.DS_Store
.rka/
.planning/

# Manuscript artifacts: a reviewer response and a submission-readiness verdict.
# Same intent as excluding manuscripts/ -- these are about the paper, not the code.
REVIEW_RESPONSE.md
SUBMISSION_STATUS.md

# Per-household shards for the real-stack arm: regenerated by
# scripts/export_households.py from the same partitions the simulation uses.
data/households/

# Manuscript exports -- the paper must not go to GitHub (double-blind, PI directive)
FedHomeGuard-IEEE-SP-overleaf/
FedHomeGuard-IEEE-SP-overleaf.zip
*-overleaf/
*-overleaf.zip
