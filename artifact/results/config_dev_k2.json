{
  "name": "dev_k2",
  "stage": 3,
  "device": "auto",
  "out_dir": "results",
  "betas": [
    0.0,
    0.05,
    0.1,
    0.2,
    0.3,
    0.4
  ],
  "seeds": [
    0
  ],
  "data": {
    "dataset": "iot-23",
    "root": "data/raw",
    "max_rows_per_device": 60000,
    "train_frac": 0.8,
    "split": "time_within_device",
    "binary": true
  },
  "partition": {
    "kind": "device_derived",
    "N": 20,
    "devices_per_household": [
      1,
      3
    ],
    "dirichlet_alpha": null,
    "match_target_S_JS": null,
    "match_tol": 0.01,
    "match_mode": "device",
    "drop_device": null,
    "seed": 0
  },
  "model": {
    "arch": "mlp",
    "hidden": [
      32,
      16
    ]
  },
  "fl": {
    "rounds_T": 15,
    "local_epochs_E": 1,
    "lr": 0.05,
    "momentum": 0.9,
    "batch_size": 512,
    "seed": 0
  },
  "adversary": {
    "beta": 0.0,
    "attack": null,
    "F2_update_space": "byzantine_unbounded",
    "F2_rho": null,
    "F3_knowledge": "gray_box",
    "F4_knows_subsample_seed": false,
    "F5_membership": "static",
    "F6_may_poison_data": false,
    "scale": 1.0,
    "seed": 0
  },
  "defense": {
    "name": "fedavg",
    "observability": "L0",
    "trim_frac": 0.2,
    "clip_norm": 5.0,
    "knows_true_beta": false,
    "root_size": 100
  },
  "cert": {
    "family": "flcert_subsample",
    "k": 2,
    "K": 100,
    "prefer_exact": true,
    "confidence": 0.999,
    "smooth_sigma": 0.01,
    "clip_norm": 5.0,
    "n_smooth": 200
  }
}